@@ -0,0 +1,89 @@
+//! Character-find commands through the byte-oriented typeahead boundary.
+
+use std::error::Error;
+use std::io;
+
+use ox_editor::{Editor, Geometry, Keys, ModeMachine, NullExprEval, TypeaheadFlags};
+use ox_text::{Buffer, Position};
+
+struct FindResult {
+    column: usize,
+    text: Vec<u8>,
+    register: Vec<u8>,
+}
+
+fn run_find(text: &str, column: usize, keys: &str) -> Result<FindResult, Box<dyn Error>> {
+    let mut editor = Editor::new();
+    let buffer = editor.create_buffer_with(Buffer::from_bytes(text.as_bytes())?, true)?;
+    let tab = editor.create_tabpage(buffer, Geometry::new(0, 0, 80, 24)?)?;
+    let window = editor.tabpage(tab)?.current_window();
+    editor.set_window_cursor(window, Position { lnum: 1, col: column })?;
+    editor.typeahead_mut().append(
+        &Keys::encode(keys.as_bytes()),
+        TypeaheadFlags::default(),
+    );
+    let mut machine = ModeMachine::default();
+    for _ in 0..=keys.len() {
+        if !machine.run_once(&mut editor, &mut NullExprEval)? {
+            let captured = editor.registers().get('"')?.map_or_else(Vec::new, |value| value.to_bytes());
+            return Ok(FindResult {
+                column: editor.window(window)?.cursor.col,
+                text: editor.buffer(buffer)?.text()?.to_bytes(),
+                register: captured,
+            });
+        }
+    }
+    Err(io::Error::other(format!("queued find command did not drain: {keys:?}")).into())
+}
+
+#[test]
+fn queued_find_targets_are_full_scalars_in_both_directions() -> Result<(), Box<dyn Error>> {
+    for target in ['\u{e9}', '\u{100}', '\u{ac00}', '\u{1f642}'] {
+        let text = format!("x{target}x{target}z");
+        let last = text.len() - 1;
+        let second = 2 + target.len_utf8();
+        for (start, keys, expected) in [
+            (0, format!("f{target}"), 1),
+            (last, format!("F{target}"), second),
+            (0, format!("2f{target}"), second),
+            (0, format!("f{target};,"), 1),
+            (last, format!("2F{target}"), 1),
+        ] {
+            let result = run_find(&text, start, &keys)?;
+            assert_eq!(result.column, expected, "{keys:?}");
+            assert_eq!(result.text, text.as_bytes());
+        }
+    }
+    // U+0141 has low byte 'A'; truncating the target must not find that A.
+    assert_eq!(run_find("xA\u{141}z", 0, "f\u{141}")?.column, 2);
+    assert_eq!(run_find("xAz", 0, "f\u{141}")?.column, 0);
+    Ok(())
+}
+
+#[test]
+fn till_stops_at_character_boundaries() -> Result<(), Box<dyn Error>> {
+    let text = "x\u{e9}\u{1f642}\u{ac00}z";
+    assert_eq!(run_find(text, 0, "t\u{ac00}")?.column, 3);
+    assert_eq!(run_find(text, 10, "T\u{e9}")?.column, 3);
+    assert_eq!(run_find("x\u{e9}x\u{e9}z", 0, "2t\u{e9}")?.column, 3);
+    Ok(())
+}
+
+#[test]
+fn find_operators_capture_whole_characters_with_directional_inclusivity() -> Result<(), Box<dyn Error>> {
+    for (text, start, keys, remaining, captured) in [
+        ("x\u{e9}z", 0, "df\u{e9}", "z", "x\u{e9}"),
+        ("x\u{1f642}z", 0, "df\u{1f642}", "z", "x\u{1f642}"),
+        ("x\u{1f642}\u{e9}z", 0, "dt\u{e9}", "\u{e9}z", "x\u{1f642}"),
+        ("x\u{e9}\u{1f642}z", 7, "dF\u{e9}", "xz", "\u{e9}\u{1f642}"),
+        ("x\u{e9}\u{1f642}z", 7, "dT\u{e9}", "x\u{e9}z", "\u{1f642}"),
+        ("x\u{e9}z", 0, "yf\u{e9}", "x\u{e9}z", "x\u{e9}"),
+        ("x\u{e9}z", 0, "vf\u{e9}y", "x\u{e9}z", "x\u{e9}"),
+        ("x\u{e9}z", 3, "vF\u{e9}y", "x\u{e9}z", "\u{e9}z"),
+    ] {
+        let result = run_find(text, start, keys)?;
+        assert_eq!(result.text, remaining.as_bytes(), "{keys:?}");
+        assert_eq!(result.register, captured.as_bytes(), "{keys:?}");
+    }
+    Ok(())
+}
