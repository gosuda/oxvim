+//! Shared screen geometry follows all attached RPC UIs, not the last caller.
+
+use std::cell::RefCell;
+use std::error::Error;
+use std::io;
+use std::rc::Rc;
+
+use ox_api::{ApiSession, Dict, Object, OxStr, Registry, core};
+use ox_editor::{Editor, Geometry};
+use ox_rpc::ChannelId;
+
+struct Session {
+    api: ApiSession,
+    registry: Registry,
+}
+
+impl Session {
+    fn new() -> Result<Self, Box<dyn Error>> {
+        let mut editor = Editor::new();
+        let buffer = editor.create_buffer(true)?;
+        editor.create_tabpage(buffer, Geometry::new(0, 0, 80, 24)?)?;
+        Ok(Self {
+            api: ApiSession::new(Rc::new(RefCell::new(editor))),
+            registry: core()?,
+        })
+    }
+
+    fn call(&self, channel: u64, name: &str, args: &[Object]) -> Result<Object, Box<dyn Error>> {
+        let (_, dispatch) = self.registry.get(name).ok_or_else(|| io::Error::other(format!("missing API {name}")))?;
+        let _caller = self.api.enter_rpc_call(ChannelId::new(channel));
+        Ok(dispatch(&self.api, args)?)
+    }
+
+    fn attach(&self, channel: u64, width: i64, height: i64) -> Result<(), Box<dyn Error>> {
+        self.call(channel, "nvim_ui_attach", &[
+            Object::Integer(width), Object::Integer(height),
+            Object::Dict(Dict(vec![(OxStr::from("ext_linegrid"), Object::Boolean(true))])),
+        ])?;
+        Ok(())
+    }
+
+    fn resize(&self, channel: u64, width: i64, height: i64) -> Result<(), Box<dyn Error>> {
+        self.call(channel, "nvim_ui_try_resize", &[Object::Integer(width), Object::Integer(height)])?;
+        Ok(())
+    }
+
+    fn assert_size(&self, width: i64, height: i64) -> Result<(), Box<dyn Error>> {
+        for (name, expected) in [("columns", width), ("lines", height)] {
+            assert_eq!(self.call(3, "nvim_get_option_value", &[
+                Object::String(OxStr::from(name)), Object::Dict(Dict::default()),
+            ])?, Object::Integer(expected), "{name}");
+        }
+        let geometry = self.api.with_editor(|editor| {
+            editor.tabpage(ox_types::TabHandle::CURRENT).map(|tab| tab.layout().size())
+        })?;
+        assert_eq!((geometry.width, geometry.height), (usize::try_from(width)?, usize::try_from(height)?));
+        Ok(())
+    }
+}
+
+#[test]
+fn ui_dimensions_use_componentwise_minima_on_attach_resize_and_detach() -> Result<(), Box<dyn Error>> {
+    let session = Session::new()?;
+    session.attach(3, 80, 40)?;
+    session.attach(4, 200, 24)?;
+    session.assert_size(80, 24)?;
+    let Object::Array(uis) = session.call(3, "nvim_list_uis", &[])? else { return Err(io::Error::other("expected UI array").into()) };
+    for (ui, (width, height)) in uis.iter().zip([(80, 40), (200, 24)]) {
+        let Object::Dict(ui) = ui else { return Err(io::Error::other("expected UI dict").into()) };
+        assert_eq!(ui.get(&OxStr::from("width")), Some(&Object::Integer(width)));
+        assert_eq!(ui.get(&OxStr::from("height")), Some(&Object::Integer(height)));
+    }
+    session.resize(3, 120, 60)?;
+    session.assert_size(120, 24)?;
+    session.resize(4, 100, 70)?;
+    session.assert_size(100, 60)?;
+    session.call(3, "nvim_ui_detach", &[])?;
+    session.assert_size(100, 70)?;
+    session.call(4, "nvim_ui_detach", &[])?;
+    session.assert_size(100, 70)?;
+    assert_eq!(session.call(4, "nvim_list_uis", &[])?, Object::Array(Vec::new()));
+    Ok(())
+}
+
+#[test]
+fn attach_order_and_rejected_requests_do_not_change_shared_size() -> Result<(), Box<dyn Error>> {
+    for sizes in [[(200, 100), (80, 24)], [(80, 24), (200, 100)]] {
+        let session = Session::new()?;
+        session.attach(3, sizes[0].0, sizes[0].1)?;
+        session.attach(4, sizes[1].0, sizes[1].1)?;
+        session.assert_size(80, 24)?;
+        let uis = session.call(3, "nvim_list_uis", &[])?;
+        assert!(session.resize(3, 0, 10).is_err());
+        assert!(session.resize(99, 10, 10).is_err());
+        assert!(session.attach(3, 10, 10).is_err());
+        assert!(session.call(99, "nvim_ui_detach", &[]).is_err());
+        session.assert_size(80, 24)?;
+        assert_eq!(session.call(3, "nvim_list_uis", &[])?, uis);
+    }
+    Ok(())
+}
 diff --git a/crates/ox-editor/tests/unicode_find.rs b/crates/ox-editor/tests/unicode_find.rs
